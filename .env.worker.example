# Worker host (.env for compose.worker.yaml)
# Copy to each worker and set the matching ID / public endpoint.
#
# worker-01.example.internal (192.0.2.11):
#   YONDER_WORKER_ID=worker-ai3
#   YONDER_WORKER_PUBLIC_ENDPOINT=http://worker-01.example.internal:8090
#
# worker-03.example.internal (192.0.2.13):
#   YONDER_WORKER_ID=worker-ai7
#   YONDER_WORKER_PUBLIC_ENDPOINT=http://worker-03.example.internal:8090
# ai5 abandoned — do not register worker-ai5.

YONDER_ENVIRONMENT=lab
YONDER_CONFIG_FILE=/app/config/environments/lab-multinode.yaml
YONDER_SECURITY__MODE=development

# Must match the control plane value. REQUIRED in production.
YONDER_SECURITY__WORKER_SHARED_SECRET=change-me-lab-worker-token
YONDER_ALLOW_NON_LOCALHOST_BIND_IN_DEVELOPMENT=true

# Control-plane Gateway on ai1.
YONDER_GATEWAY_URL=http://control-plane.example.internal:8080

# Unique per worker — must be on the control-plane allowlist.
YONDER_WORKER_ID=worker-ai3
YONDER_WORKER_DISPLAY_NAME=ai3 (lab worker)

# How the Gateway reaches THIS worker (DNS or LAN IP + port). Never use 0.0.0.0 here.
YONDER_WORKER_PUBLIC_ENDPOINT=http://worker-01.example.internal:8090

YONDER_PUBLISH_WORKER=0.0.0.0:8090
