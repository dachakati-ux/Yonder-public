# Python
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.tox/
*.egg

# Node / Next.js
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-store/

# Environment and secrets
.env
.env.local
.env.*.local
.env.control-plane
.env.worker
!.env.example
secrets/
*.pem
*.key

# IDE / OS
.DS_Store
.idea/
.vscode/
