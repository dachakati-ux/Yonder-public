# Control-plane host ai1 (.env for compose.control-plane.yaml)
# Hostname: control-plane.example.internal / 192.0.2.10
#
# LAB ONLY — PENDING SECURITY REVIEW / REVISION
# YONDER_SECURITY__MODE=development supplies a non-production mock principal.
# Do not use as a production security baseline.

YONDER_ENVIRONMENT=lab
YONDER_CONFIG_FILE=/app/config/environments/lab-multinode.yaml
YONDER_SECURITY__MODE=development

# Must match every worker host value. REQUIRED in production.
YONDER_SECURITY__WORKER_SHARED_SECRET=change-me-lab-worker-token
YONDER_ALLOW_NON_LOCALHOST_BIND_IN_DEVELOPMENT=true

# Browser + CORS must use the address operators open in a browser.
YONDER_CONSOLE_ORIGIN=http://control-plane.example.internal:3000
NEXT_PUBLIC_YONDER_GATEWAY_URL=http://control-plane.example.internal:8080

# Comma-separated allowlist matching ai3 and ai7.
YONDER_WORKER_REGISTRATION__MODE=allowlist
YONDER_WORKER_REGISTRATION__ALLOWED_WORKER_IDS=worker-ai3,worker-ai7
YONDER_WORKER_REGISTRATION__ACCEPT_UNTRUSTED=false

YONDER_DATABASE_URL=sqlite:////app/data/yonder.db
# Comma-separated server-side roots the Models UI may scan and prepare.
YONDER_MODEL_ROOTS=/app/vendor/model-bundles,/models
YONDER_PUBLISH_GATEWAY=0.0.0.0:8080
YONDER_PUBLISH_CONSOLE=0.0.0.0:3000

# MCP client/server — off by default (see docs/mcp.md). Uncomment only after
# reviewing allowlists; HTTP URLs must match http_url_allowlist prefixes.
# YONDER_MCP__ENABLED=false
# YONDER_MCP__SERVER_ENABLED=false
# YONDER_MCP__BRIDGE_INTO_TOOL_EXECUTOR=false
# For the IDE-facing process (separate from Gateway): YONDER_GATEWAY_URL=http://127.0.0.1:8080
