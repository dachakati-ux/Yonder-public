# Lab Forgejo — loopback only. Copy to /etc/yonder/forgejo.ini on ai1.
# LAB ONLY — PENDING SECURITY REVIEW / REVISION
# Do not set HTTP_ADDR to 0.0.0.0. Reach via SSH tunnel:
#   ssh -N -L 3001:127.0.0.1:3001 ai1

APP_NAME = Yonder Lab Forgejo
RUN_USER = yonder
WORK_PATH = /srv/yonder-storage/forgejo
RUN_MODE = prod

[server]
PROTOCOL = http
DOMAIN = 127.0.0.1
HTTP_ADDR = 127.0.0.1
HTTP_PORT = 3001
ROOT_URL = http://127.0.0.1:3001/
DISABLE_SSH = true
START_SSH_SERVER = false
OFFLINE_MODE = true
LFS_START_SERVER = false

[database]
DB_TYPE = sqlite3
PATH = /srv/yonder-storage/forgejo/data/forgejo.db

[repository]
ROOT = /srv/yonder-storage/forgejo/repositories

[lfs]
PATH = /srv/yonder-storage/forgejo/lfs

[log]
ROOT_PATH = /srv/yonder-storage/forgejo/log
LEVEL = Info

[security]
INSTALL_LOCK = true
# INTERNAL_TOKEN is generated by scripts/provision-ai1-forgejo.sh at install time.
# SECRET_KEY is injected via EnvironmentFile=/etc/yonder/forgejo.env
# (FORGEJO__SECURITY__SECRET_KEY). Never commit a real value.

[service]
DISABLE_REGISTRATION = true
REQUIRE_SIGNIN_VIEW = true
ENABLE_NOTIFY_MAIL = false

[openid]
ENABLE_OPENID_SIGNIN = false
ENABLE_OPENID_SIGNUP = false

[other]
SHOW_FOOTER_VERSION = true
