# ==============================================================================
# Yonder Environment Configuration (.env.example)
# ==============================================================================
# Copy this file to `.env` before starting Yonder (or run `./start.sh`, which
# copies it automatically if `.env` does not exist):
#
#   cp .env.example .env
#
# NEVER commit your real `.env` file or real secrets to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Core Mode & Config File
# ------------------------------------------------------------------------------
# "development" enables local dev defaults (mock user principal, localhost).
# Change to "production" when deploying behind your upstream auth/ingress.
YONDER_ENVIRONMENT=development
YONDER_CONFIG_FILE=config/environments/development.yaml

# ------------------------------------------------------------------------------
# 2. Ports, Network & URLs
# ------------------------------------------------------------------------------
# Change any port here if it conflicts with another service on your machine.
# Docker Compose and ./start.sh automatically use these values.
#
#   YONDER_CONSOLE_PORT  (3000) — Web Console UI
#   YONDER_GATEWAY__PORT (8080) — Gateway OpenAI-compatible & operator API
#   YONDER_WORKER__PORT  (8090) — Worker agent API (metrics & model lifecycle)
#   YONDER_MCP_PORT      (8095) — IDE MCP server (yonder-mcp Streamable HTTP)
#   YONDER_POSTGRES_PORT (5432) — Optional PostgreSQL (--postgres)
#
# For process-local runs (without Docker), bind to 127.0.0.1.
# Docker Compose automatically overrides container binds to 0.0.0.0.
YONDER_GATEWAY__HOST=127.0.0.1
YONDER_GATEWAY__PORT=8080
YONDER_WORKER__HOST=127.0.0.1
YONDER_WORKER__PORT=8090
YONDER_CONSOLE_PORT=3000
YONDER_POSTGRES_PORT=5432

# Browser URLs (used by the Web Console and CORS).
# Update these if you change the ports above or expose Yonder on a LAN/domain.
YONDER_CONSOLE_ORIGIN=http://127.0.0.1:3000
NEXT_PUBLIC_YONDER_GATEWAY_URL=http://127.0.0.1:8080

# Local state file (used inside container volume /app/data or local ./data)
YONDER_STATE_FILE=data/gateway-state.json

# ------------------------------------------------------------------------------
# 3. Security & Authentication Boundary
# ------------------------------------------------------------------------------
# "development" injects a mock RequestPrincipal so you can use Yonder locally
# without an upstream auth proxy. Refused if YONDER_ENVIRONMENT=production.
# In production, set YONDER_SECURITY__MODE=trusted_ingress.
YONDER_SECURITY__MODE=development

# Shared secret between Gateway and Worker nodes.
# Optional in development; REQUIRED in production.
# Generate with: openssl rand -hex 32
# YONDER_SECURITY__WORKER_SHARED_SECRET=replace-with-long-random-secret

# ------------------------------------------------------------------------------
# 4. Persistence (SQLite by default, or PostgreSQL)
# ------------------------------------------------------------------------------
# Default: local SQLite database.
YONDER_DATABASE_URL=sqlite:///./data/yonder.db
# Optional PostgreSQL (use with `./start.sh --postgres` or compose.persistence.yaml):
# YONDER_DATABASE_URL=postgresql+psycopg://yonder:yonder@postgres:5432/yonder

# ------------------------------------------------------------------------------
# 5. MCP (Model Context Protocol) — Enabled by default
# ------------------------------------------------------------------------------
# Gateway MCP client (/v1/mcp/*) and IDE MCP server (yonder-mcp on :8095).
YONDER_MCP__ENABLED=true
YONDER_MCP__SERVER_ENABLED=true
YONDER_MCP_PORT=8095
# Optional subject header forwarded by yonder-mcp to Gateway:
# YONDER_MCP_SUBJECT=developer

# ------------------------------------------------------------------------------
# 6. Optional: Connect a Local LLM Runtime (llama.cpp / Ollama / LM Studio)
# ------------------------------------------------------------------------------
# When running Yonder in Docker on macOS/Windows, use `host.docker.internal`
# to reach an inference server running on your host machine:
# YONDER_LLAMA_CPP__BASE_URL=http://host.docker.internal:1234

# ------------------------------------------------------------------------------
# 7. Logging
# ------------------------------------------------------------------------------
YONDER_LOG_LEVEL=INFO
YONDER_LOG_CONTENT=false
