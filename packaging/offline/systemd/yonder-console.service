[Unit]
Description=Yonder Console
After=network-online.target yonder-gateway.service
Wants=network-online.target

[Service]
Type=simple
User=yonder
Group=yonder
EnvironmentFile=/etc/yonder/control-plane.env
WorkingDirectory=/opt/yonder/console
Environment=PATH=/opt/yonder/node/bin:/usr/bin
Environment=NODE_ENV=production
ExecStart=/opt/yonder/node/bin/npm run start -- -H 0.0.0.0 -p 3000
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/yonder/console /var/log/yonder

[Install]
WantedBy=multi-user.target
