[Unit]
Description=Yonder Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yonder
Group=yonder
EnvironmentFile=/etc/yonder/control-plane.env
WorkingDirectory=/opt/yonder/repo
ExecStartPre=/opt/yonder/venv/bin/alembic -c database/alembic.ini upgrade head
ExecStart=/opt/yonder/venv/bin/yonder-gateway
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=65535
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/yonder /var/log/yonder /etc/yonder

[Install]
WantedBy=multi-user.target
