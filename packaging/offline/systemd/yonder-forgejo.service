[Unit]
Description=Yonder Lab Forgejo (loopback only)
Documentation=https://forgejo.org/docs/latest/
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=yonder
Group=yonder
EnvironmentFile=-/etc/yonder/forgejo.env
WorkingDirectory=/srv/yonder-storage/forgejo
ExecStart=/opt/yonder/forgejo/forgejo web --config /etc/yonder/forgejo.ini
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
LimitNOFILE=65535
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/srv/yonder-storage/forgejo /etc/yonder
# Fail closed: unit must never be started with a non-loopback HTTP_ADDR
# (enforced by scripts/provision-ai1-forgejo.sh before enable).

[Install]
WantedBy=multi-user.target
