# Copied to /etc/yonder/worker.env by install-worker.sh (values replaced).
# ai3 → worker-ai3 / http://worker-01.example.internal:8090
# ai7 → worker-ai7 / http://worker-03.example.internal:8090
# (ai5 abandoned)
YONDER_ENVIRONMENT=lab
YONDER_CONFIG_FILE=/opt/yonder/repo/config/environments/lab-multinode.yaml
YONDER_SECURITY_MODE=development
YONDER_ALLOW_NON_LOCALHOST_BIND_IN_DEVELOPMENT=true
YONDER_WORKER__HOST=0.0.0.0
YONDER_WORKER__PORT=8090
YONDER_GATEWAY_URL=http://control-plane.example.internal:8080
YONDER_WORKER_ID=worker-ai3
YONDER_WORKER_DISPLAY_NAME=ai3 (lab worker)
YONDER_WORKER_PUBLIC_ENDPOINT=http://worker-01.example.internal:8090
