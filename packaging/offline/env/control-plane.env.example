# Copied to /etc/yonder/control-plane.env by install.sh (values replaced).
# Lab inventory: ai1 control plane; worker-ai3 + worker-ai7 (ai5 abandoned).
#
# LAB ONLY — PENDING SECURITY REVIEW / REVISION
# development mode = non-production mock principal; not a production baseline.
YONDER_ENVIRONMENT=lab
YONDER_REPO_ROOT=/opt/yonder/repo
YONDER_CONFIG_FILE=/opt/yonder/repo/config/environments/lab-multinode.yaml
YONDER_SECURITY_MODE=development
YONDER_ALLOW_NON_LOCALHOST_BIND_IN_DEVELOPMENT=true
YONDER_GATEWAY__HOST=0.0.0.0
YONDER_GATEWAY__PORT=8080
YONDER_CONSOLE_ORIGIN=http://control-plane.example.internal:3000
YONDER_DATABASE_URL=sqlite:////var/lib/yonder/yonder.db
YONDER_STATE_FILE=/var/lib/yonder/gateway-state.json
YONDER_MODEL_ROOTS=/srv/yonder/models
YONDER_WORKER_REGISTRATION__MODE=allowlist
YONDER_WORKER_REGISTRATION__ALLOWED_WORKER_IDS=worker-ai3,worker-ai7
YONDER_WORKER_REGISTRATION__ACCEPT_UNTRUSTED=false
NEXT_PUBLIC_YONDER_GATEWAY_URL=http://control-plane.example.internal:8080
