# Example environment for worker-managed llama.cpp (ai1 / ai3).
# Copy to /etc/yonder/worker.env overlays or set via YONDER_* env vars.

# Enable the worker process manager (preferred over the static sidecar).
YONDER_LLAMA_CPP_RUNTIME__ENABLED=true
YONDER_LLAMA_CPP_RUNTIME__BINARY_PATH=/opt/yonder/runtimes/llama.cpp-b10167-cuda-sm70/bin/llama-server
YONDER_LLAMA_CPP_RUNTIME__LIBRARY_PATH=/opt/cuda-12.6/lib64
# Keep managed processes loopback-only on every worker. Remote Gateways receive
# a deployment-scoped proxy URL under YONDER_WORKER_PUBLIC_ENDPOINT (:8090).
YONDER_LLAMA_CPP_RUNTIME__LISTEN_HOST=127.0.0.1
YONDER_LLAMA_CPP_RUNTIME__BASE_PORT=8100
YONDER_LLAMA_CPP_RUNTIME__CTX_SIZE=8192
YONDER_LLAMA_CPP_RUNTIME__N_GPU_LAYERS=999
YONDER_LLAMA_CPP_RUNTIME__THREADS=8
# Keep explicit CUDA/runtime headroom on every selected GPU.
YONDER_LLAMA_CPP_RUNTIME__VRAM_RESERVE_GB=1
# Stable same-host multi-GPU default. "tensor" is intentionally unsupported
# because llama.cpp documents it as experimental with auto-fit disabled.
YONDER_LLAMA_CPP_RUNTIME__MULTI_GPU_SPLIT_MODE=layer

# Gateway (control plane) still needs the provider adapter:
# YONDER_LLAMA_CPP__ENABLED=true
# YONDER_LLAMA_CPP__BASE_URL=http://127.0.0.1:8000
# YONDER_LLAMA_CPP__SERVED_MODEL=qwen3.6-35b-a3b-q4
# YONDER_LLAMA_CPP__WORKER_ID=worker-ai1
